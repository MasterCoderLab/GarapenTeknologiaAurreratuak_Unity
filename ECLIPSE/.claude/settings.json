{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(ls *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git add *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git stash *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(~/.ssh/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./ProjectSettings/**)",
      "Edit(./Packages/**)",
      "Edit(./Assets/ThirdParty/**)",
      "Edit(./**/*.unity)",
      "Edit(./**/*.prefab)",
      "Edit(./**/*.meta)",
      "Edit(./**/*.asset)",
      "Edit(./**/*.mat)",
      "Edit(./**/*.controller)",
      "Edit(./**/*.anim)",
      "Edit(./**/*.lighting)"
    ]
  }
}
